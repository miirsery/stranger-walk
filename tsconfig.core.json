{
  // Игровая логика и контент: без DOM, без Vue, без Phaser.
  // Отсутствие "DOM" в lib гарантирует на уровне компилятора, что ядро переносимо.
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.core.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/core-types",
    "paths": {
      "@core/*": ["./src/core/*"],
      "@content/*": ["./src/content/*"]
    }
  },
  "include": ["src/core/**/*.ts", "src/content/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
