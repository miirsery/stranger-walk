{
  // Конфиги сборки и тесты ядра (выполняются в Node через Vitest).
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/node-types",
    "paths": {
      "@core/*": ["./src/core/*"],
      "@content/*": ["./src/content/*"]
    }
  },
  "include": ["vite.config.ts", "src/**/*.test.ts"],
  "references": [{ "path": "./tsconfig.core.json" }]
}
